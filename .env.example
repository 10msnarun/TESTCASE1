# ==============================================================================
# LIS Cloud Consulting & Admin Console Environment Configuration
# ==============================================================================

# APP_URL: Base URL where the web application is hosted (e.g. https://liscloud.com)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. AZURE DATABASE FOR POSTGRESQL (Shared by Public Website & Admin Dashboard)
# ------------------------------------------------------------------------------
# Connection details for the existing Azure Database for PostgreSQL instance.
# All queries are executed server-side via Express & Drizzle ORM.
SQL_HOST="your-azure-postgres-server.postgres.database.azure.com"
SQL_USER="your-db-admin-user"
SQL_PASSWORD="your-db-strong-password"
SQL_DB_NAME="your-database-name"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign and verify admin session tokens
ADMIN_AUTH_SECRET="your-cryptographically-random-admin-secret-key"

# Primary executive administrator account
ADMIN_EMAIL="admin@liscloud.io"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (Triggered on Consultation & Job Submissions)
# ------------------------------------------------------------------------------
# Destination email address that receives inbound notifications
ADMIN_NOTIFICATION_EMAIL="admin@liscloud.io"

# From header displayed on outbound emails
EMAIL_FROM="\"LIS Cloud Consulting\" <notifications@liscloud.io>"

# SMTP Transport Configuration (Supports SendGrid, Azure Communication Services,
# Amazon SES, Mailgun, or standard enterprise SMTP)
# NOTE: If these are not configured, the system operates in resilient simulated
# mode, logging the full formatted notification to the console and admin logs.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_SECURE="false"

# ------------------------------------------------------------------------------
# 4. RUNTIME SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
NODE_ENV="development"
